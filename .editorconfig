root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,hpp,c}]
indent_size = 4

[*.java]
indent_size = 4

[*.{xml,json,yml,yaml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 4
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
